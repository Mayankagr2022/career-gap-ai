// CareerGap AI — schema v2
//
// Design notes
//  - IDs are UUIDs generated by Postgres (gen_random_uuid, built in since PG13), so no uuid-ossp.
//  - Skills are a canonical catalog (Skill + SkillAlias). Jobs, resumes, gaps and market data
//    reference it by id instead of free-text strings.
//  - Roadmaps (milestones/tasks) and coaching chats (messages) are real tables, not JSON blobs.
//  - Secrets (refresh tokens, reset/verify tokens) are stored hashed (sha256), never in plaintext.
//  - Embeddings are vector(768) with an HNSW cosine index (created in the migration SQL).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─── Identity & Auth ──────────────────────────────────────────────────────────
model User {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String       @unique
  name            String
  password        String?
  avatar          String?
  role            Role         @default(USER)
  provider        AuthProvider @default(LOCAL) // how the account was first created
  isEmailVerified Boolean      @default(false)
  isActive        Boolean      @default(true)
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  oauthAccounts   OAuthAccount[]
  authTokens      AuthToken[]
  sessions        UserSession[]
  resumes         Resume[]
  jobs            Job[]
  analyses        Analysis[]
  recommendations Recommendation[]
  roadmaps        Roadmap[]
  coachingSessions CoachingSession[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  aiUsageLogs     AiUsageLog[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

/// One row per linked social login, so a user can have password + Google + LinkedIn.
model OAuthAccount {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @db.Uuid
  provider   AuthProvider
  providerId String
  createdAt  DateTime     @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Single-use tokens (password reset, email verification). Only the hash is stored.
model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model UserSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ─── Skills catalog ───────────────────────────────────────────────────────────
model Skill {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String        @unique // normalised key: "nextjs", "c++", "c#"
  name      String        @unique // display name: "Next.js"
  category  SkillCategory @default(TECHNICAL)
  createdAt DateTime      @default(now())

  aliases      SkillAlias[]
  relatedTo    SkillRelation[] @relation("SkillRelationFrom")
  relatedFrom  SkillRelation[] @relation("SkillRelationTo")
  jobSkills    JobSkill[]
  resumeSkills ResumeSkill[]
  gaps         AnalysisSkillGap[]
  marketStat   SkillMarketStat?
  snapshots    SkillMarketSnapshot[]

  @@index([category])
  @@map("skills")
}

model SkillAlias {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId String @db.Uuid
  alias   String @unique // normalised alias slug, e.g. "reactjs" -> React

  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@map("skill_aliases")
}

model SkillRelation {
  skillId        String @db.Uuid
  relatedSkillId String @db.Uuid

  skill          Skill  @relation("SkillRelationFrom", fields: [skillId], references: [id], onDelete: Cascade)
  related        Skill  @relation("SkillRelationTo", fields: [relatedSkillId], references: [id], onDelete: Cascade)

  @@id([skillId, relatedSkillId])
  @@index([relatedSkillId])
  @@map("skill_relations")
}

// ─── Skill market data ────────────────────────────────────────────────────────
/// Current market numbers per skill.
model SkillMarketStat {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId       String      @unique @db.Uuid
  demandScore   Float
  trend         SkillTrend  @default(STABLE)
  averageSalary Float?
  jobCount      Int         @default(0)
  topCompanies  String[]
  source        String      @default("user-data")
  lastUpdated   DateTime    @default(now())
  createdAt     DateTime    @default(now())

  skill         Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([demandScore])
  @@index([trend])
  @@map("skill_market_stats")
}

/// Time series so trends can be computed from history instead of a hand-set label.
model SkillMarketSnapshot {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId       String   @db.Uuid
  demandScore   Float
  averageSalary Float?
  jobCount      Int      @default(0)
  capturedAt    DateTime @default(now())

  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId, capturedAt])
  @@map("skill_market_snapshots")
}

// ─── Resumes ──────────────────────────────────────────────────────────────────
model Resume {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @db.Uuid
  filename     String
  originalName String
  fileUrl      String
  fileKey      String // S3 key
  fileSize     Int
  mimeType     String
  status       ResumeStatus @default(PENDING)
  parsedData   Json? // ParsedResume JSON (full AI parse output)
  rawText      String?      @db.Text
  atsScore     Float?
  errorMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       ResumeSkill[]
  analyses     Analysis[]
  embeddings   ResumeEmbedding[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("resumes")
}

model ResumeSkill {
  resumeId String @db.Uuid
  skillId  String @db.Uuid

  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([resumeId, skillId])
  @@index([skillId])
  @@map("resume_skills")
}

model ResumeEmbedding {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resumeId   String                 @db.Uuid
  content    String                 @db.Text
  embedding  Unsupported("vector(768)")
  chunkIndex Int
  // Model that produced the vector; only vectors of the same model are comparable
  embeddingModel String             @default("gemini-embedding-001")
  createdAt  DateTime               @default(now())

  resume     Resume                 @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, chunkIndex])
  @@map("resume_embeddings")
}

// ─── Jobs ─────────────────────────────────────────────────────────────────────
model Job {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  title           String
  company         String
  description     String   @db.Text
  location        String?
  remote          Boolean  @default(false)
  salaryMin       Float?
  salaryMax       Float?
  salaryCurrency  String?  @default("USD")
  experienceLevel String?
  education       String?
  jobType         String? // FULL_TIME, PART_TIME, CONTRACT, etc.
  industry        String?
  /// Set when the job was created from an uploaded file; such jobs keep their description read-only.
  sourceFilename  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          JobSkill[]
  analyses        Analysis[]
  embeddings      JobEmbedding[]

  @@index([userId, isActive, createdAt])
  @@map("jobs")
}

model JobSkill {
  jobId      String          @db.Uuid
  skillId    String          @db.Uuid
  importance JobSkillImportance @default(REQUIRED)

  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill      Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

model JobEmbedding {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String                 @db.Uuid
  content    String                 @db.Text
  embedding  Unsupported("vector(768)")
  chunkIndex Int
  // Model that produced the vector; only vectors of the same model are comparable
  embeddingModel String             @default("gemini-embedding-001")
  createdAt  DateTime               @default(now())

  job        Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, chunkIndex])
  @@map("job_embeddings")
}

// ─── Analyses ─────────────────────────────────────────────────────────────────
model Analysis {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @db.Uuid
  resumeId         String         @db.Uuid
  jobId            String         @db.Uuid
  status           AnalysisStatus @default(PENDING)
  matchScore       Float?
  atsScore         Float?
  fitAssessment    FitAssessment?
  executiveSummary String?        @db.Text
  strengths        String[]
  weaknesses       String[]
  recommendations  String[]
  rawAnalysis      Json? // full AI response, kept for audit/debug
  processingTime   Int? // milliseconds
  errorMessage     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume           Resume                @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job              Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillGaps        AnalysisSkillGap[]
  atsSuggestions   AnalysisAtsSuggestion[]
  aiRecommendations Recommendation[]
  roadmaps         Roadmap[]
  coachingSessions CoachingSession[]

  @@index([userId, createdAt])
  @@index([resumeId])
  @@index([jobId])
  @@index([status])
  @@map("analyses")
}

model AnalysisSkillGap {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisId    String          @db.Uuid
  skillId       String?         @db.Uuid
  skillName     String // as reported by the AI; skillId links to the catalog when resolved
  importance    GapImportance
  category      SkillCategory   @default(TECHNICAL)
  currentLevel  Int             @default(0)
  requiredLevel Int             @default(0)

  analysis      Analysis        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  skill         Skill?          @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([analysisId])
  @@index([skillId])
  @@map("analysis_skill_gaps")
}

model AnalysisAtsSuggestion {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisId String        @db.Uuid
  type       AtsIssueType
  severity   IssueSeverity
  message    String        @db.Text
  suggestion String        @db.Text

  analysis   Analysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@map("analysis_ats_suggestions")
}

// ─── Recommendations ──────────────────────────────────────────────────────────
model Recommendation {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String             @db.Uuid
  analysisId  String             @db.Uuid
  type        RecommendationType
  title       String
  description String             @db.Text
  url         String?
  duration    String?
  difficulty  DifficultyLevel    @default(INTERMEDIATE)
  priority    Int                @default(0)
  skills      String[]
  provider    String? // Coursera, Udemy, etc.
  cost        String? // FREE, PAID, SUBSCRIPTION
  isCompleted Boolean            @default(false)
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis    Analysis           @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([userId, isCompleted])
  @@index([analysisId, priority])
  @@index([type])
  @@map("recommendations")
}

// ─── Roadmaps ─────────────────────────────────────────────────────────────────
model Roadmap {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  analysisId    String    @db.Uuid
  title         String
  targetRole    String
  targetDate    DateTime?
  isActive      Boolean   @default(true)
  completionPct Float     @default(0) // denormalised; recomputed when a task changes
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis      Analysis           @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  milestones    RoadmapMilestone[]

  @@index([userId, isActive, createdAt])
  @@index([analysisId])
  @@map("roadmaps")
}

model RoadmapMilestone {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roadmapId   String  @db.Uuid
  title       String
  description String? @db.Text
  weekNumber  Int     @default(1)
  position    Int     @default(0)

  roadmap     Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks       RoadmapTask[]

  @@index([roadmapId, position])
  @@map("roadmap_milestones")
}

model RoadmapTask {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  milestoneId String             @db.Uuid
  title       String
  description String?            @db.Text
  type        RecommendationType @default(COURSE)
  url         String?
  position    Int                @default(0)
  isCompleted Boolean            @default(false)
  completedAt DateTime?

  milestone   RoadmapMilestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId, position])
  @@map("roadmap_tasks")
}

// ─── Coaching ─────────────────────────────────────────────────────────────────
model CoachingSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  analysisId String?  @db.Uuid
  title      String?
  context    Json? // snapshot of resume/job context given to the coach
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis   Analysis?         @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  messages   CoachingMessage[]

  @@index([userId, updatedAt])
  @@map("coaching_sessions")
}

model CoachingMessage {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String      @db.Uuid
  role      ChatRole
  content   String      @db.Text
  createdAt DateTime    @default(now())

  session   CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("coaching_messages")
}

// ─── Notifications ────────────────────────────────────────────────────────────
model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ─── Operations ───────────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @db.Uuid
  action     String // e.g. auth.login, auth.register, admin.role_change
  entity     String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model AiUsageLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @db.Uuid
  feature      String? // e.g. gap-analysis, coach
  model        String
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int
  success      Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}

// ─── Enums ────────────────────────────────────────────────────────────────────
enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  LINKEDIN
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

enum ResumeStatus {
  PENDING
  PROCESSING
  ANALYZED
  FAILED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FitAssessment {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum RecommendationType {
  PROJECT
  CERTIFICATION
  COURSE
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SkillCategory {
  TECHNICAL
  SOFT
  DOMAIN
  TOOL
  CERTIFICATION
}

enum SkillTrend {
  RISING
  STABLE
  DECLINING
}

enum JobSkillImportance {
  REQUIRED
  PREFERRED
}

enum GapImportance {
  CRITICAL
  IMPORTANT
  NICE_TO_HAVE
}

enum AtsIssueType {
  KEYWORD_MISSING
  FORMAT_ISSUE
  LENGTH_ISSUE
  SECTION_MISSING
  QUANTIFICATION_MISSING
}

enum IssueSeverity {
  HIGH
  MEDIUM
  LOW
}

enum ChatRole {
  USER
  ASSISTANT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}
