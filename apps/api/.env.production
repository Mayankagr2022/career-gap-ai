# NestJS Production Environment Variables
# Copy the structure of your development .env here, but with production values!

NODE_ENV=production
PORT=3001
API_PREFIX=api/v1

# Important: This tells OAuth and emails where to send users back to in production
FRONTEND_URL=https://your-domain.com

# Database (Production Database URL)
DATABASE_URL="postgresql://user:password@production-db-host:5432/postgres?pgbouncer=true"

# Redis (Production Redis URL)
REDIS_URL=redis://production-redis-host:6379
REDIS_HOST=production-redis-host
REDIS_PORT=6379

# Production Secrets
JWT_SECRET=production-secret-replace-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=production-refresh-secret-replace-me
JWT_REFRESH_EXPIRES_IN=30d

# OAuth Redirects (Point to the production API URL)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.your-domain.com/api/v1/auth/google/callback

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_CALLBACK_URL=https://api.your-domain.com/api/v1/auth/linkedin/callback

# API Keys
OPENAI_API_KEY=your-production-openai-key

# AWS S3 
AWS_ACCESS_KEY_ID=your-production-aws-key
AWS_SECRET_ACCESS_KEY=your-production-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-production-bucket

# Rate limiting: per-IP requests per minute on endpoints that call the AI provider
AI_THROTTLE_LIMIT=10
# Per-IP requests per minute for POST /auth/forgot-password
FORGOT_PASSWORD_THROTTLE_LIMIT=5
