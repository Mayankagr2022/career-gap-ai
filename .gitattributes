# Source files are stored with LF in the repository; working copies may use either ending without showing as changed
* text=auto eol=lf

# Shell scripts run inside Linux containers: keep LF line endings even when checked out on Windows
*.sh text eol=lf
Dockerfile text eol=lf

# Husky hooks are shell scripts: keep LF line endings even when checked out on Windows
.husky/* text eol=lf
