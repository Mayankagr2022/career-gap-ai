# Copy to .env on the server (next to docker-compose.yml) and fill it in:
#   cp .env.example .env && chmod 600 .env
# This file holds secrets: it stays on the server and is never committed or sent to GitHub.

# ---- Public address -------------------------------------------------------------------------------
# Host name only, no https:// and no trailing slash. Its DNS A record must point at this server.
DOMAIN=app.example.com

# ---- Database (PostgreSQL runs in a container; the data lives in a Docker volume) --------------------
POSTGRES_DB=careergap
POSTGRES_USER=careergap
# Use letters and digits only. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Auth ---------------------------------------------------------------------------------------------
# Two different long random values:  openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- File storage (any S3-compatible bucket) -----------------------------------------------------------
# AWS S3: leave AWS_S3_ENDPOINT empty and use the bucket's region.
# Cloudflare R2:   AWS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   AWS_REGION=auto
# Backblaze B2:    AWS_S3_ENDPOINT=https://s3.<region>.backblazeb2.com             AWS_REGION=<region>
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- AI providers (a provider with no key is skipped; with none, the AI features are unavailable) -------
NVIDIA_API_KEY=
GEMINI_API_KEY=
# AI_PROVIDER_ORDER=nvidia,gemini
# AI_EMBEDDING_PROVIDER_ORDER=nvidia,gemini

# ---- Optional: social login (the callback URLs are derived from DOMAIN) ---------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---- Optional: outgoing email (password reset) ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
