# HTTPS in front of the API. Caddy obtains and renews the certificate by itself (the domain must point at this
# server and ports 80 and 443 must be reachable). With DOMAIN=localhost it uses a local test certificate.
# The API's CORS rules decide which websites may call it; this file only terminates HTTPS and forwards.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Resume uploads are limited to 10 MB by the API; reject anything much larger early
	request_body {
		max_size 12MB
	}

	reverse_proxy api:3001
}
